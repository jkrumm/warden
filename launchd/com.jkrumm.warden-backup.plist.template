<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.warden-backup</string>
  <!-- Daily ledger backup. scripts/warden-backup.sh takes a VACUUM INTO snapshot and
       rsyncs ~/.warden/ to homelab:/mnt/hdd/backups/warden/, which the existing restic
       container already walks on its way to B2 — see the script's own header for why
       that needs no homelab-side change.

       03:10 sits between hermes-backup (03:00) and restic's 03:30 sweep, so the day's
       snapshot is on the HDD before restic reads it. StartCalendarInterval and not an
       interval: this is a daily job, and launchd runs a missed calendar job once at
       wake rather than replaying every skipped firing. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.warden-backup</string>
    <string>--owner</string>
    <string>warden</string>
    <string>--every</string>
    <string>86400</string>
    <string>--</string>
    <string>/bin/zsh</string>
    <string>__HOME__/SourceRoot/warden/scripts/warden-backup.sh</string>
  </array>
  <!-- Under `jobrun` (dotfiles): every run is recorded in ~/.local/state/jobs and graded by jobs-grade
       (the job source opens an item for warden when it fails). No `--kuma`: the script pushes its own
       "Warden Backup - Push" heartbeat only after a clean snapshot, bundle and rsync, and its push URL
       lives in a mode-600 file because the op:// ref cannot be seeded from the mini (see the script),
       which jobrun's `--kuma op-ref` cannot read. jobrun is a `#!/usr/bin/env bun` script and
       launchd's PATH has neither bun nor ~/.local/bin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>10</integer>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/warden-backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/warden-backup.err</string>
</dict>
</plist>
